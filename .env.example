# Airdrop Tennis — environment variables
# Copy to .env for local development. Set the same values in Vercel → Project → Settings → Environment Variables.

# Canonical production app URL (used for Supabase auth email redirects in production builds)
EXPO_PUBLIC_APP_URL=https://app.airdroptennis.com

# Stripe (client-side publishable key only)
# EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Optional: server-side / API routes (Vercel)
# APP_URL=https://app.airdroptennis.com
# EXPO_PUBLIC_SUPABASE_URL=https://rozxeqqwxpnfqbyvtvch.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
